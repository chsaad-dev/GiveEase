<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFF">

    <!-- Simplified Header -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/home_header_gradient">

            <!-- Navigation Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:strokeColor="#E3F2FD"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_back"
                        app:tint="#1565C0" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Create New Campaign"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="16dp"
                    android:gravity="center_vertical" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#E3F2FD"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivHelp"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_help"
                        app:tint="#1565C0" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Simple Progress Indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fill all required fields to create your campaign"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Required *"
                    android:textSize="12sp"
                    android:textColor="#E23232"
                    android:textStyle="bold"
                    android:background="#B9C5D1"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    app:cornerRadius="6dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Single Page Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Media Upload Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Campaign Media"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnAddImage"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="#F8F9FF"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:strokeColor="#1565C0"
                            app:strokeWidth="2dp"
                            android:layout_marginEnd="16dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <!-- Image Preview (shown after selection) -->
                                <ImageView
                                    android:id="@+id/ivImagePreview"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:visibility="gone" />

                                <!-- Default upload UI -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:padding="16dp">

                                    <ImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/sample_ngo"
                                        app:tint="#1565C0" />

                                    <TextView
                                        android:id="@+id/tvAddPhotoLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Add Photos"
                                        android:textSize="12sp"
                                        android:textColor="#1565C0"
                                        android:textStyle="bold"
                                        android:layout_marginTop="8dp" />

                                    <TextView
                                        android:id="@+id/tvImageCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0/5"
                                        android:textSize="10sp"
                                        android:textColor="#546E7A"
                                        android:layout_marginTop="4dp" />
                                </LinearLayout>
                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Make your campaign stand out"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#1A237E"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="• Add high-quality images\n• Show the impact\n• Build donor trust"
                                android:textSize="12sp"
                                android:textColor="#546E7A"
                                android:lineSpacingExtra="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Basic Information Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Basic Information"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E"
                        android:layout_marginBottom="20dp" />

                    <!-- Category Dropdown -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Campaign Category *"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="1dp"
                            app:cardBackgroundColor="#FAFBFF"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <Spinner
                                android:id="@+id/spinnerCategory"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:padding="16dp"
                                android:textSize="16sp" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Title Input -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Campaign Title *"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="1dp"
                            app:cardBackgroundColor="#FAFBFF"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <EditText
                                android:id="@+id/etTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Enter a compelling title"
                                android:textSize="16sp"
                                android:background="@android:color/transparent"
                                android:padding="16dp"
                                android:inputType="text"
                                android:imeOptions="actionNext"
                                android:maxLines="1" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Description Input -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Description *"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#1A237E" />

                            <TextView
                                android:id="@+id/tvCharCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0/500"
                                android:textSize="12sp"
                                android:textColor="#546E7A" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="1dp"
                            app:cardBackgroundColor="#FAFBFF"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <EditText
                                android:id="@+id/etDescription"
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                android:hint="Describe your campaign purpose, who it will help, and impact..."
                                android:textSize="14sp"
                                android:gravity="top"
                                android:background="@android:color/transparent"
                                android:padding="16dp"
                                android:inputType="textMultiLine"
                                android:maxLines="6" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Urgency Level -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Urgency Level"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupUrgency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="8dp">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipLow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Low"
                                android:textSize="13sp"
                                android:checkable="true"
                                app:chipBackgroundColor="@color/background"
                                app:chipStrokeColor="#1565C0"
                                app:chipStrokeWidth="1dp"
                                style="@style/Widget.Material3.Chip.Filter" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Medium"
                                android:textSize="13sp"
                                android:checkable="true"
                                app:chipBackgroundColor="@color/background"
                                app:chipStrokeColor="#1565C0"
                                app:chipStrokeWidth="1dp"
                                style="@style/Widget.Material3.Chip.Filter" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipHigh"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="High"
                                android:textSize="13sp"
                                android:checkable="true"
                                app:chipBackgroundColor="@color/background"
                                app:chipStrokeColor="#1565C0"
                                app:chipStrokeWidth="1dp"
                                style="@style/Widget.Material3.Chip.Filter" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipEmergency"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Emergency"
                                android:textSize="13sp"
                                android:checkable="true"
                                app:chipBackgroundColor="@color/background"
                                app:chipStrokeColor="#1565C0"
                                app:chipStrokeWidth="1dp"
                                style="@style/Widget.Material3.Chip.Filter" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Campaign Goals Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Campaign Goals"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E"
                        android:layout_marginBottom="20dp" />

                    <!-- Target Quantity -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target Quantity/Amount *"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="12dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="1dp"
                                app:cardBackgroundColor="#FAFBFF"
                                app:strokeColor="#E0E0E0"
                                app:strokeWidth="1dp">

                                <EditText
                                    android:id="@+id/etTargetQuantity"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Enter quantity"
                                    android:textSize="16sp"
                                    android:background="@android:color/transparent"
                                    android:padding="16dp"
                                    android:imeOptions="actionNext"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="1dp"
                                app:cardBackgroundColor="#FAFBFF"
                                app:strokeColor="#E0E0E0"
                                app:strokeWidth="1dp">

                                <Spinner
                                    android:id="@+id/spinnerUnit"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@android:color/transparent"
                                    android:padding="16dp"
                                    android:textSize="14sp" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Campaign Duration -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Campaign End Date *"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="1dp"
                            app:cardBackgroundColor="#FAFBFF"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <EditText
                                android:id="@+id/etEndDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Select end date"
                                android:textSize="16sp"
                                android:background="@android:color/transparent"
                                android:padding="16dp"
                                android:inputType="none"
                                android:clickable="true"
                                android:focusable="false" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Auto-close Option -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Auto-close campaign when target is reached"
                            android:textSize="14sp"
                            android:textColor="#1A237E" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchAutoClose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="#1565C0"
                            app:trackTint="#E3F2FD"
                            android:checked="true" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item Details Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardItemDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Item Details"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E"
                        android:layout_marginBottom="20dp" />

                    <!-- Item Condition -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Item Condition"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupCondition"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="8dp">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipNew"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="New"
                                android:textSize="13sp"
                                android:checkable="true"
                                app:chipBackgroundColor="@color/background"
                                app:chipStrokeColor="#1565C0"
                                app:chipStrokeWidth="1dp"
                                style="@style/Widget.Material3.Chip.Filter" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipUsed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Used - Good"
                                android:textSize="13sp"
                                android:checkable="true"
                                app:chipBackgroundColor="@color/background"
                                app:chipStrokeColor="#1565C0"
                                app:chipStrokeWidth="1dp"
                                style="@style/Widget.Material3.Chip.Filter" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipRefurbished"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Refurbished"
                                android:textSize="13sp"
                                android:checkable="true"
                                app:chipBackgroundColor="@color/background"
                                app:chipStrokeColor="#1565C0"
                                app:chipStrokeWidth="1dp"
                                style="@style/Widget.Material3.Chip.Filter" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>

                    <!-- Specific Requirements -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Specific Requirements"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="1dp"
                            app:cardBackgroundColor="#FAFBFF"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <EditText
                                android:id="@+id/etSpecificNeeds"
                                android:layout_width="match_parent"
                                android:layout_height="120dp"
                                android:hint="e.g., Blood types needed, clothing sizes, medicine requirements..."
                                android:textSize="14sp"
                                android:gravity="top"
                                android:background="@android:color/transparent"
                                android:padding="16dp"
                                android:inputType="textMultiLine"
                                android:maxLines="6" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Verification Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Verification"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E8F5E9">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NGO Verified"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#2E7D32"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your organization is verified. This builds trust with donors and increases campaign success."
                        android:textSize="14sp"
                        android:textColor="#546E7A"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Create Campaign Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateCampaign"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Create Campaign"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:backgroundTint="#1565C0"
                app:elevation="4dp"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>