<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/home_header_gradient"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        android:paddingHorizontal="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_back"
                    app:tint="@android:color/white" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit Profile"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="Save"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:backgroundTint="@android:color/white"
                app:elevation="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keep your NGO's information up to date"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:alpha="0.8"
            android:layout_marginStart="56dp" />
    </LinearLayout>

    <!-- Edit Form -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile Picture Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnChangeLogo"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        app:cardCornerRadius="60dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/primary"
                        app:cardBackgroundColor="#F0F4F8"
                        android:clickable="true"
                        android:focusable="true">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ivNgoLogo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop" />

                            <LinearLayout
                                android:id="@+id/llLogoPlaceholder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@drawable/ic_ngo"
                                    app:tint="@color/primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Change Logo"
                                    android:textSize="12sp"
                                    android:textColor="@color/primary"
                                    android:textStyle="bold"
                                    android:layout_marginTop="8dp" />
                            </LinearLayout>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Basic Information -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Basic Information"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="16dp" />
                        
                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:layout_marginBottom="20dp"
                        android:background="@color/primary" />

                    <!-- NGO Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NGO Name *"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <EditText
                                android:id="@+id/etNgoName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Enter NGO name"
                                android:textSize="15sp"
                                android:textColor="@android:color/black"
                                android:background="@android:color/transparent"
                                android:padding="16dp"
                                android:maxLines="1" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Tagline -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tagline *"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <EditText
                                android:id="@+id/etTagline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Brief slogan or tagline"
                                android:textSize="15sp"
                                android:textColor="@android:color/black"
                                android:background="@android:color/transparent"
                                android:padding="16dp"
                                android:maxLines="2" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Contact Information -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contact Email *"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <EditText
                                android:id="@+id/etContactEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="contact@ngo.org"
                                android:textSize="15sp"
                                android:textColor="@android:color/black"
                                android:inputType="textEmailAddress"
                                android:background="@android:color/transparent"
                                android:padding="16dp"
                                android:maxLines="1" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Phone Number -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phone Number"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <EditText
                                android:id="@+id/etPhoneNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="+92 3XX XXXXXXX"
                                android:textSize="15sp"
                                android:textColor="@android:color/black"
                                android:inputType="phone"
                                android:background="@android:color/transparent"
                                android:padding="16dp"
                                android:maxLines="1" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Website -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Website"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <EditText
                                android:id="@+id/etWebsite"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="https://ngo.org"
                                android:textSize="15sp"
                                android:textColor="@android:color/black"
                                android:inputType="textUri"
                                android:background="@android:color/transparent"
                                android:padding="16dp"
                                android:maxLines="1" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Detailed Information -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detailed Information"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="16dp" />
                        
                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:layout_marginBottom="20dp"
                        android:background="@color/primary" />

                    <!-- Mission Statement -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mission Statement *"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <EditText
                                android:id="@+id/etMission"
                                android:layout_width="match_parent"
                                android:layout_height="120dp"
                                android:hint="Describe your NGO's purpose..."
                                android:textSize="14sp"
                                android:textColor="@android:color/black"
                                android:gravity="top"
                                android:background="@android:color/transparent"
                                android:padding="16dp"
                                android:inputType="textMultiLine"
                                android:maxLines="5" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Vision -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vision"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <EditText
                                android:id="@+id/etVision"
                                android:layout_width="match_parent"
                                android:layout_height="100dp"
                                android:hint="What is your long-term vision?"
                                android:textSize="14sp"
                                android:textColor="@android:color/black"
                                android:gravity="top"
                                android:background="@android:color/transparent"
                                android:padding="16dp"
                                android:inputType="textMultiLine"
                                android:maxLines="4" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Core Values -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Core Values"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <EditText
                                android:id="@+id/etCoreValues"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:hint="List core values (one per line)..."
                                android:textSize="14sp"
                                android:textColor="@android:color/black"
                                android:gravity="top"
                                android:background="@android:color/transparent"
                                android:padding="16dp"
                                android:inputType="textMultiLine"
                                android:maxLines="4" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Operational Details -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Operational Details"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="16dp" />
                        
                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:layout_marginBottom="20dp"
                        android:background="@color/primary" />

                    <!-- Headquarters Address -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Headquarters Address *"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <EditText
                                android:id="@+id/etHeadquarters"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:hint="Enter complete address..."
                                android:textSize="14sp"
                                android:textColor="@android:color/black"
                                android:gravity="top"
                                android:background="@android:color/transparent"
                                android:padding="16dp"
                                android:inputType="textMultiLine"
                                android:maxLines="3" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Service Categories -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Service Categories"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupServiceCategories"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:selectionRequired="false"
                            app:singleSelection="false">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipEducation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Education"
                                android:textSize="13sp"
                                app:chipBackgroundColor="#F8F9FA"
                                app:chipStrokeColor="@color/primary"
                                app:chipStrokeWidth="1dp"
                                app:checkedIcon="@drawable/ic_check"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipHealthcare"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Healthcare"
                                android:textSize="13sp"
                                app:chipBackgroundColor="#F8F9FA"
                                app:chipStrokeColor="@color/primary"
                                app:chipStrokeWidth="1dp"
                                app:checkedIcon="@drawable/ic_check"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipDisasterRelief"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Disaster Relief"
                                android:textSize="13sp"
                                app:chipBackgroundColor="#F8F9FA"
                                app:chipStrokeColor="@color/primary"
                                app:chipStrokeWidth="1dp"
                                app:checkedIcon="@drawable/ic_check"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPovertyAlleviation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Poverty Alleviation"
                                android:textSize="13sp"
                                app:chipBackgroundColor="#F8F9FA"
                                app:chipStrokeColor="@color/primary"
                                app:chipStrokeWidth="1dp"
                                app:checkedIcon="@drawable/ic_check"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipWomenEmpowerment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Women Empowerment"
                                android:textSize="13sp"
                                app:chipBackgroundColor="#F8F9FA"
                                app:chipStrokeColor="@color/primary"
                                app:chipStrokeWidth="1dp"
                                app:checkedIcon="@drawable/ic_check"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipEnvironment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Environment"
                                android:textSize="13sp"
                                app:chipBackgroundColor="#F8F9FA"
                                app:chipStrokeColor="@color/primary"
                                app:chipStrokeWidth="1dp"
                                app:checkedIcon="@drawable/ic_check"
                                android:checkable="true" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>

                    <!-- Geographical Coverage -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Geographical Coverage"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <EditText
                                android:id="@+id/etCoverage"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:hint="Regions or countries..."
                                android:textSize="14sp"
                                android:textColor="@android:color/black"
                                android:gravity="top"
                                android:background="@android:color/transparent"
                                android:padding="16dp"
                                android:inputType="textMultiLine"
                                android:maxLines="2" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>