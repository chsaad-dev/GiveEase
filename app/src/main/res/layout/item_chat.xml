<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgNgo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:src="@drawable/sample_ngo"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="NGO profile"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNgoName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edhi Foundation"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"/>

            <TextView
                android:id="@+id/tvLastMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thank you for your support!"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvUnread"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2"
            android:backgroundTint="@color/error"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_unread_circle"
            android:padding="6dp"
            android:visibility="visible"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
