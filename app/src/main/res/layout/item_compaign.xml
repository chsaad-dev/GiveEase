<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgCampaign"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:src="@drawable/sample_compaign1"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvCampaignTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flood Relief Fund"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"/>

        <TextView
            android:id="@+id/tvCampaignDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Help with shelter and food."
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:layout_marginTop="2dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:progress="65"
            android:progressTint="@color/progress"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnDonate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Donate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textSize="12sp"
            android:minHeight="32dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

