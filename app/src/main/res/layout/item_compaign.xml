<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- Image with overlay info -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp">

            <ImageView
                android:id="@+id/imgCampaign"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/sample_compaign1" />

            <!-- Overlay tag, e.g., "Health" -->
            <TextView
                android:id="@+id/tvCategoryTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Health"
                android:padding="6dp"
                android:textColor="@color/black"
                android:background="@drawable/bg_badge"
                android:textStyle="bold"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"/>

            <!-- Overlay: progress percent -->
            <TextView
                android:id="@+id/tvPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="65%"
                android:textColor="@color/white"
                android:background="@drawable/bg_progress_overlay"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"/>
        </FrameLayout>

        <!-- Main content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingTop="10dp">

            <TextView
                android:id="@+id/tvCampaignTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flood Relief Fund"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvCampaignDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Help with shelter and food for flood victims."
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/black"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end"/>

            <!-- Fund info and progress bar row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvRaised"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rs 35,500"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/tvGoal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / Rs 50,000"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:layout_marginStart="2dp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tvDaysLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14 days left"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/black"
                    android:layout_marginEnd="2dp"/>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progress="65"
                android:max="100"
                android:progressTint="@color/progress"
                android:backgroundTint="@color/outline"
                android:layout_marginTop="8dp"/>

            <Button
                android:id="@+id/btnDonate"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Donate"
                style="@style/Widget.Material3.Button"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>