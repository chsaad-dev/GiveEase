<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Campaign Image -->
        <ImageView
            android:id="@+id/imgCampaign"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@drawable/sample_compaign1" />

        <!-- Urgency Badge -->
        <TextView
            android:id="@+id/tvUrgency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="-20dp"
            android:background="#FF9800" />

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- NGO Name -->
            <TextView
                android:id="@+id/tvNgoName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NGO Name"
                android:textSize="12sp"
                android:textColor="#1565C0"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- Campaign Title -->
            <TextView
                android:id="@+id/tvCampaignTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Campaign Title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="8dp" />

            <!-- Description -->
            <TextView
                android:id="@+id/tvCampaignDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Campaign description goes here..."
                android:textSize="14sp"
                android:textColor="#546E7A"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="12dp" />

            <!-- Category Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textSize="12sp"
                app:chipBackgroundColor="#E3F2FD"
                android:layout_marginBottom="12dp" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:progress="75"
                android:max="100"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressTint="#4CAF50"
                android:layout_marginBottom="8dp" />

            <!-- Progress Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="350 / 500 Boxes"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E" />

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="75%"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50" />
            </LinearLayout>

            <!-- Days Left -->
            <TextView
                android:id="@+id/tvDaysLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 days left"
                android:textSize="12sp"
                android:textColor="#546E7A"
                android:layout_marginBottom="12dp" />

            <!-- Donate Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDonate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Donate Now"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="#1565C0" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>