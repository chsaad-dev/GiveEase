<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header with Image and Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Campaign Image -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F5F5F5">

                <ImageView
                    android:id="@+id/imgCampaign"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_ngo" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Title and Category -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tvCampaignTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Campaign Title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvCampaignCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textSize="13sp"
                    android:textColor="#546E7A"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Status Badge -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E8F5E9">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvCampaignDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Campaign description"
            android:textSize="14sp"
            android:textColor="#546E7A"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="16dp" />

        <!-- Progress Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvCurrentQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Items"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />

            <TextView
                android:id="@+id/tvTargetQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" of 0 Items"
                android:textSize="14sp"
                android:textColor="#78909C" />

            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1565C0" />
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="0"
            android:progressTint="#2E7D32"
            android:progressBackgroundTint="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvDaysLeft"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="30 days left"
                android:textSize="13sp"
                android:textColor="#2E7D32"
                android:drawablePadding="4dp" />

            <TextView
                android:id="@+id/tvDonorCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 donors"
                android:textSize="13sp"
                android:textColor="#546E7A" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Edit"
                android:textSize="11sp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:layout_marginEnd="4dp"
                app:cornerRadius="12dp"
                app:backgroundTint="#1565C0"
                app:icon="@drawable/ic_edit"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                style="@style/Widget.Material3.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatusChange"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Pause"
                android:textSize="11sp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:layout_marginHorizontal="2dp"
                app:cornerRadius="12dp"
                app:strokeColor="#1565C0"
                app:strokeWidth="1dp"
                android:textColor="#1565C0"
                app:icon="@drawable/ic_pause"
                app:iconSize="16dp"
                app:iconTint="#1565C0"
                app:iconGravity="textStart"
                android:backgroundTint="@android:color/transparent"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnComplete"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Finish"
                android:textSize="11sp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:layout_marginHorizontal="2dp"
                app:cornerRadius="12dp"
                app:strokeColor="#388E3C"
                app:strokeWidth="1dp"
                android:textColor="#388E3C"
                app:icon="@drawable/ic_check"
                app:iconSize="16dp"
                app:iconTint="#388E3C"
                app:iconGravity="textStart"
                android:backgroundTint="@android:color/transparent"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Del."
                android:textSize="11sp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:layout_marginStart="4dp"
                app:cornerRadius="12dp"
                app:strokeColor="#D32F2F"
                app:strokeWidth="1dp"
                android:textColor="#D32F2F"
                app:icon="@drawable/ic_delete"
                app:iconSize="16dp"
                app:iconTint="#D32F2F"
                app:iconGravity="textStart"
                android:backgroundTint="@android:color/transparent"
                style="@style/Widget.Material3.Button.OutlinedButton" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>