<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Make a Donation"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your contribution makes a difference"
        android:textSize="14sp"
        android:textColor="#546E7A"
        android:layout_marginBottom="20dp" />

    <!-- Campaign Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#F8F9FF"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvCampaignTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Campaign Title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvNgoName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NGO Name"
                android:textSize="13sp"
                android:textColor="#1565C0"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="250 / 500 Boxes (50%)"
                android:textSize="13sp"
                android:textColor="#546E7A"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remaining: 250 Boxes"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4CAF50" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quantity Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="How much would you like to donate?"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FAFBFF"
            app:strokeColor="#1565C0"
            app:strokeWidth="2dp">

            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter quantity"
                android:textSize="16sp"
                android:background="@android:color/transparent"
                android:padding="16dp"
                android:inputType="number"
                android:maxLength="10" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Boxes"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:minWidth="60dp" />
    </LinearLayout>

    <!-- Optional Message -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add a message (Optional)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FAFBFF"
        app:strokeColor="#E0E0E0"
        app:strokeWidth="1dp"
        android:layout_marginBottom="24dp">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Share your thoughts or encouragement..."
            android:textSize="14sp"
            android:gravity="top"
            android:background="@android:color/transparent"
            android:padding="16dp"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:maxLength="200" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Monetary Section (Hidden by default) -->
    <LinearLayout
        android:id="@+id/llMonetarySection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bank Accounts for Transfer"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#F1F8E9"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvNgoBankDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading bank details..."
                android:textSize="14sp"
                android:textColor="#33691E"
                android:padding="16dp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload Transfer Receipt *"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUploadReceipt"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Image"
            app:icon="@android:drawable/ic_menu_camera"
            app:backgroundTint="#EDF2F7"
            android:textColor="#1565C0"
            app:iconTint="#1565C0"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReceiptPreview"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivReceiptPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
            
            <!-- Remove icon -->
            <ImageView
                android:id="@+id/btnRemoveReceipt"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/circle_white_bg"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#D32F2F" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Physical Items Section (Hidden by default) -->
    <LinearLayout
        android:id="@+id/llPhysicalSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="24dp">
        
        <!-- Condition -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item Condition *"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginBottom="8dp" />
            
        <RadioGroup
            android:id="@+id/rgCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <RadioButton
                android:id="@+id/rbNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="New"
                android:textColor="#546E7A" />
            <RadioButton
                android:id="@+id/rbUsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gently Used"
                android:textColor="#546E7A" />
            <RadioButton
                android:id="@+id/rbRepair"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Needs Repair"
                android:textColor="#546E7A" />
        </RadioGroup>

        <!-- Item Proof Photo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload Item Photo *"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUploadItemPhoto"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Capture or Select Photo"
            app:icon="@android:drawable/ic_menu_camera"
            app:backgroundTint="#EDF2F7"
            android:textColor="#1565C0"
            app:iconTint="#1565C0"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardItemPreview"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivItemPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
            
            <ImageView
                android:id="@+id/btnRemoveItemPhoto"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/circle_white_bg"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#D32F2F" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Handover Method -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Handover Logistics *"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginBottom="8dp" />
            
        <RadioGroup
            android:id="@+id/rgHandover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <RadioButton
                android:id="@+id/rbDropoff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="I will drop it off at the NGO"
                android:textColor="#546E7A" />
                
            <TextView
                android:id="@+id/tvNgoDropoffAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NGO Address: Loading..."
                android:textSize="13sp"
                android:textColor="#1565C0"
                android:background="#FAFBFF"
                android:padding="8dp"
                android:layout_marginStart="32dp"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>
                
            <RadioButton
                android:id="@+id/rbPickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Request an NGO Rider to pickup"
                android:textColor="#546E7A" />
                
            <!-- Pickup Info Fields -->
            <LinearLayout
                android:id="@+id/llPickupInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="32dp"
                android:visibility="gone"
                android:layout_marginTop="8dp">
                
                <EditText
                    android:id="@+id/etPickupPhone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Your Phone Number"
                    android:inputType="phone"
                    android:padding="8dp"
                    android:background="@drawable/et_bg"
                    android:layout_marginBottom="8dp"/>
                    
                <EditText
                    android:id="@+id/etPickupAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="2"
                    android:hint="Complete Pickup Address"
                    android:inputType="textMultiLine"
                    android:padding="8dp"
                    android:background="@drawable/et_bg"
                    android:gravity="top"/>
            </LinearLayout>
        </RadioGroup>
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textSize="15sp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:cornerRadius="12dp"
            app:strokeColor="#1565C0"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDonate"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Donate Now"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="#1565C0"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>