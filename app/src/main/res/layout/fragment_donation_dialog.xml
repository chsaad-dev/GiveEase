<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Make a Donation"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your contribution makes a difference"
        android:textSize="14sp"
        android:textColor="#546E7A"
        android:layout_marginBottom="20dp" />

    <!-- Campaign Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#F8F9FF"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvCampaignTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Campaign Title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvNgoName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NGO Name"
                android:textSize="13sp"
                android:textColor="#1565C0"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="250 / 500 Boxes (50%)"
                android:textSize="13sp"
                android:textColor="#546E7A"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remaining: 250 Boxes"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4CAF50" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quantity Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="How much would you like to donate?"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FAFBFF"
            app:strokeColor="#1565C0"
            app:strokeWidth="2dp">

            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter quantity"
                android:textSize="16sp"
                android:background="@android:color/transparent"
                android:padding="16dp"
                android:inputType="number"
                android:maxLength="10" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Boxes"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:minWidth="60dp" />
    </LinearLayout>

    <!-- Optional Message -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add a message (Optional)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FAFBFF"
        app:strokeColor="#E0E0E0"
        app:strokeWidth="1dp"
        android:layout_marginBottom="24dp">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Share your thoughts or encouragement..."
            android:textSize="14sp"
            android:gravity="top"
            android:background="@android:color/transparent"
            android:padding="16dp"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:maxLength="200" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textSize="15sp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:cornerRadius="12dp"
            app:strokeColor="#1565C0"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDonate"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Donate Now"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="#1565C0"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>