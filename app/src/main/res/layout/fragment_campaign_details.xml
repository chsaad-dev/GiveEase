<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="380dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@android:color/white">

            <!-- Image Gallery -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerImages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Bottom gradient scrim -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/gradient_image_overlay" />

                <!-- Image Counter (pill shape) -->
                <TextView
                    android:id="@+id/tvImageCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1/3"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/urgency_badge_bg_low"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp" />

                <!-- Tab Indicator -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:background="@android:color/transparent"
                    app:tabBackground="@drawable/tab_selector"
                    app:tabGravity="center"
                    app:tabIndicatorHeight="0dp"
                    app:tabMaxWidth="14dp"
                    app:tabMinWidth="14dp"
                    app:tabPaddingStart="0dp"
                    app:tabPaddingEnd="0dp" />
            </FrameLayout>

            <!-- Header Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                app:layout_collapseMode="pin">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_back"
                        app:tint="#1565C0" />
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnShare"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_share"
                        app:tint="#1565C0" />

                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Campaign Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- NGO Name with icon -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_organization"
                            app:tint="#1565C0"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/tvNgoName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NGO Name"
                            android:textSize="16sp"
                            android:textColor="#1565C0"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tvCampaignTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Campaign Title"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="14dp" />

                    <!-- Category & Urgency -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/tvCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Category"
                            android:textSize="12sp"
                            android:textColor="#1565C0"
                            app:chipBackgroundColor="#E3F2FD"
                            app:chipCornerRadius="18dp"
                            app:chipStrokeWidth="0dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:id="@+id/tvUrgencyBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Emergency"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:background="@drawable/urgency_badge_bg_emergency" />
                    </LinearLayout>

                    <!-- Description -->
                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Campaign description goes here..."
                        android:textSize="15sp"
                        android:textColor="#546E7A"
                        android:lineSpacingExtra="5dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Progress Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section Header with icon -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_trending_up"
                            app:tint="#1565C0"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Campaign Progress"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E" />
                    </LinearLayout>

                    <!-- Rounded Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:progress="75"
                        android:max="100"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:progressDrawable="@drawable/rounded_progress_bar"
                        android:layout_marginBottom="14dp" />

                    <!-- Progress Info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <!-- Collected -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Collected"
                                android:textSize="12sp"
                                android:textColor="#78909C"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/tvCurrentQuantity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="350 Items"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="#2E7D32" />
                        </LinearLayout>

                        <!-- Target -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Target"
                                android:textSize="12sp"
                                android:textColor="#78909C"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/tvTargetQuantity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="500 Items"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="#1A237E" />
                        </LinearLayout>

                        <!-- Circular Progress Percent -->
                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/progress_circle_bg" />

                            <TextView
                                android:id="@+id/tvProgressPercent"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="75%"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#2E7D32"
                                android:gravity="center" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Stats Row: Days Left + Donors -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Days Left -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stat_card_bg"
                            android:padding="16dp"
                            android:layout_marginEnd="6dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_access_time"
                                app:tint="#1565C0"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:id="@+id/tvDaysLeft"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="#1565C0"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Days Left"
                                android:textSize="12sp"
                                android:textColor="#78909C" />
                        </LinearLayout>

                        <!-- Donors -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stat_card_bg"
                            android:padding="16dp"
                            android:layout_marginStart="6dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_person"
                                app:tint="#2E7D32"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:id="@+id/tvDonorCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="156"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="#2E7D32"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Donors"
                                android:textSize="12sp"
                                android:textColor="#78909C" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item Condition -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardItemCondition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="#2E7D32"
                        android:layout_marginEnd="10dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Item Condition"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvItemCondition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="New"
                            android:textSize="14sp"
                            android:textColor="#546E7A" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Specific Requirements -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSpecificRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_description"
                            app:tint="#1565C0"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Specific Requirements"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSpecificRequirements"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Requirements go here..."
                        android:textSize="14sp"
                        android:textColor="#546E7A"
                        android:lineSpacingExtra="5dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Campaign Timeline -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="80dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section Header with icon -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="#1565C0"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Campaign Timeline"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E" />
                    </LinearLayout>

                    <!-- Created date -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/stat_card_bg"
                        android:padding="14dp"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_play"
                            app:tint="#2E7D32"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Created"
                            android:textSize="13sp"
                            android:textColor="#546E7A" />

                        <TextView
                            android:id="@+id/tvCreatedDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15 Jan 2024"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E" />
                    </LinearLayout>

                    <!-- End date -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/stat_card_bg"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_access_time"
                            app:tint="#E53935"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ends on"
                            android:textSize="13sp"
                            android:textColor="#546E7A" />

                        <TextView
                            android:id="@+id/tvEndDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30 Jan 2024"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#E53935" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Action Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomActionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardElevation="12dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContactNgo"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Contact NGO"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                app:cornerRadius="26dp"
                app:strokeColor="#1565C0"
                app:strokeWidth="2dp"
                android:textColor="#1565C0"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDonate"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Donate Now"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                app:cornerRadius="26dp"
                app:backgroundTint="#2E7D32"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>