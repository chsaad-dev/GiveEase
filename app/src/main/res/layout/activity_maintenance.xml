<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#F8FAFF">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:cardCornerRadius="60dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#E3F2FD"
        android:layout_marginBottom="32dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_maintenance"
            app:tint="#1565C0" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvMaintenanceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Maintenance Mode"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvMaintenanceMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="We're currently performing maintenance to improve your experience. Please check back later."
        android:textSize="16sp"
        android:textColor="#546E7A"
        android:textAlignment="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvMaintenanceSubtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thank you for your patience!"
        android:textSize="14sp"
        android:textColor="#90A4AE"
        android:textAlignment="center"
        android:layout_marginBottom="48dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRefresh"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:text="Check Status"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:backgroundTint="#1565C0"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:text="Logout"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:backgroundTint="#F44336"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeColor="#F44336"
        app:strokeWidth="2dp" />

</LinearLayout>